APP_NAME=Go.Conference
APP_ENV=localhost # localhost | production
APP_PORT=8080
# IP/hostname server yang bisa dijangkau peserta untuk media (kosong = lokal saja).
# Jangan isi domain yang diproxy Cloudflare/tunnel: media UDP tidak lewat sana.
APP_HOST=
# Rentang UDP media (buka di firewall)
APP_UDP_PORT_MIN=50000
APP_UDP_PORT_MAX=50100

STUN_SERVER=stun:stun.l.google.com:19302
